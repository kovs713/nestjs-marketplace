    {
      "id": "authnotify-delivery",
      "type": "text",
      "x": 1700,
      "y": 2990,
      "width": 847.4666748046875,
      "height": 69,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
      "fontSize": 20,
      "frameId": null,
      "groupIds": [],
      "index": "b1S",
      "isDeleted": false,
      "lineHeight": 1.15,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Redis adapter fans out across replicas. Socket event: notification; deliveryId = notification.id.\nDuplicate socket delivery is possible: client deduplicates by deliveryId. No durable socket replay.\nOffline recovery: GET /notifications; PATCH /notifications/:id/read; POST /notifications/read-all.",
      "roughness": 0,
      "roundness": null,
      "seed": 1210432049,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Redis adapter fans out across replicas. Socket event: notification; deliveryId = notification.id.\nDuplicate socket delivery is possible: client deduplicates by deliveryId. No durable socket replay.\nOffline recovery: GET /notifications; PATCH /notifications/:id/read; POST /notifications/read-all.",
      "textAlign": "left",
      "updated": 1792190644380,
      "version": 1,
      "versionNonce": 1903624031,
      "verticalAlign": "top"
    },
    {
      "id": "authnotify-sources",
      "type": "text",
      "x": 1700,
      "y": 3115,
      "width": 929.066650390625,
      "height": 46,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 2,
