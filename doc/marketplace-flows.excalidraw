      "locked": false,
      "opacity": 100,
      "originalText": "REPLAY KEYS\nCheckout: (user, Idempotency-Key) → original acceptance snapshot.\nInventory: orderId:reserve, scoped separately by Reserve / Commit / Release.\nPayment: create:orderId, orderId:capture, orderId:refund. Replays do not double-charge.",
      "roughness": 0,
      "roundness": null,
      "seed": 1171461919,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
