      "groupIds": [],
      "index": "b1T",
      "isDeleted": false,
      "lineHeight": 1.15,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Orders requests: CONFIRMED / FAILED / CANCELED. Payment: SUCCEEDED / FAILED / REFUNDED.\nNo email/SMS delivery. No stock notification producer. Intermediate statuses stay internal.",
      "roughness": 0,
      "roundness": null,
      "seed": 30342495,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Orders requests: CONFIRMED / FAILED / CANCELED. Payment: SUCCEEDED / FAILED / REFUNDED.\nNo email/SMS delivery. No stock notification producer. Intermediate statuses stay internal.",
      "textAlign": "left",
      "updated": 1792190644380,
      "version": 1,
      "versionNonce": 1157786129,
      "verticalAlign": "top"
    },
    {
      "id": "recovery-safety",
      "type": "text",
      "x": 40,
      "y": 3200,
      "width": 838.0499877929688,
      "height": 20.7,
      "angle": 0,
      "autoResize": true,
