      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "DATA OWNERSHIP — PostgreSQL / Drizzle, separate service databases\nUsers: accounts + refresh hashes    Catalog: products + stock projection    Inventory: stocks + reservations\nOrders: cart + price snapshots + saga    Payment: payments + attempts    Notification: notifications + read state",
      "roughness": 0,
      "roundness": null,
