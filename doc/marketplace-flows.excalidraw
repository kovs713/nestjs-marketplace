      "isDeleted": false,
      "lineHeight": 1.15,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "TRANSPORT BOUNDARY\ngRPC: queries, checkout commands and immediate outcomes. Orders owns saga recovery.\nKafka: product initialization, stock projections and notification requests only.\nOrder/payment domain events remain internal; no unused status-fact streams are published.",
      "roughness": 1,
      "roundness": null,
      "seed": 120140165,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "TRANSPORT BOUNDARY\ngRPC: queries, checkout commands and immediate outcomes. Orders owns saga recovery.\nKafka: product initialization, stock projections and notification requests only.\nOrder/payment domain events remain internal; no unused status-fact streams are published.",
      "textAlign": "left",
      "updated": 1792190644380,
      "version": 1,
      "versionNonce": 199062507,
      "verticalAlign": "top"
    },
