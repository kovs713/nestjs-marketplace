    },
    {
      "id": "card3-label",
      "type": "text",
      "x": 1510,
      "y": 1775,
      "width": 660,
      "height": 230,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 175848285,
      "version": 3,
      "versionNonce": 1637977067,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792525432811,
      "link": null,
      "locked": false,
      "text": "AUTH & TRUST BOUNDARY\n\n• tokens issued only by users-service:\n  access + refresh JWT, Argon2 hashing,\n  hashed single-use refresh rotation\n• gateway verifies JWT + role guards,\n  forwards verified sub as x-user-id\n• notification sockets verify the same JWT\n• internal gRPC trusts the private network\n  and x-user-id — no second JWT check",
      "originalText": "AUTH & TRUST BOUNDARY\n\n• tokens issued only by users-service:\n  access + refresh JWT, Argon2 hashing,\n  hashed single-use refresh rotation\n• gateway verifies JWT + role guards,\n  forwards verified sub as x-user-id\n• notification sockets verify the same JWT\n• internal gRPC trusts the private network\n  and x-user-id — no second JWT check",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "autoResize": true,
      "lineHeight": 1.25,
      "containerId": "card3",
      "index": "b09V",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
