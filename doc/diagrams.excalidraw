    {
      "id": "6wg041QTmYan_jOCzExmS",
      "type": "text",
      "x": 3379.6689357437717,
      "y": -1166.170844222681,
      "width": 799.9168142973884,
      "height": 450.8799636785052,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": "0PWPLf3t_rX9yqM9rlHfp",
      "index": "b7Y",
      "roundness": null,
      "seed": 2118640677,
      "version": 2026,
      "versionNonce": 489498507,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792526714457,
      "created": 1792526173581,
      "locked": false,
      "text": "If something happens, it will be prevented at\nthe Catalog Service boundary, and no event\nwill be sent to initialize the stock in the\ninventory-service.\nAnd if something goes wrong during\ninitialization, it will be queued in the outbox\nand sent after a timeout.\n\nConfigured globally in ->\nlibs/common/src/outbox/outbox.module.ts",
      "fontSize": 36.070397094280416,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If something happens, it will be prevented at the Catalog Service boundary, and no event will be sent to initialize the stock in the inventory-service.\nAnd if something goes wrong during initialization, it will be queued in the outbox and sent after a timeout.\n\nConfigured globally in -> libs/common/src/outbox/outbox.module.ts",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
      "link": null
    },
