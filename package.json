{
  "name": "nestjs-marketplace",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build --all",
    "deploy": "nest deploy",
    "format": "oxfmt --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start --watch",
    "start:api-gateway": "nest start api-gateway --watch",
    "start:users": "nest start users-service --watch",
    "start:catalog": "nest start catalog-service --watch",
    "start:inventory": "nest start inventory-service --watch",
    "start:notification": "nest start notification-service --watch",
    "start:orders": "nest start orders-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:all": "bun run start:api-gateway & bun start:users & bun run start:catalog & bun run start:inventory & bun run start:notification & bun run start:orders & bun run start:payment & wait",
    "infra:up": "docker compose -f infra/docker/compose.yml up -d postgres kafka kafka-init-topics redis minio minio-init",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "infra:reset": "docker compose -f infra/docker/compose.yml down && docker compose -f infra/docker/compose.yml up -d postgres kafka kafka-init-topics redis minio minio-init",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/nestjs-marketplace/main",
    "db:generate:catalog": "cd apps/catalog-service && drizzle-kit generate",
    "db:migrate:catalog": "cd apps/catalog-service && drizzle-kit migrate",
    "db:generate:inventory": "cd apps/inventory-service && drizzle-kit generate",
    "db:migrate:inventory": "cd apps/inventory-service && drizzle-kit migrate",
    "db:generate:orders": "cd apps/orders-service && drizzle-kit generate",
    "db:migrate:orders": "cd apps/orders-service && drizzle-kit migrate",
    "db:generate:payment": "cd apps/payment-service && drizzle-kit generate",
    "db:migrate:payment": "cd apps/payment-service && drizzle-kit migrate",
    "db:generate:users": "cd apps/users-service && drizzle-kit generate",
    "db:migrate:users": "cd apps/users-service && drizzle-kit migrate",
    "db:generate:notification": "cd apps/notification-service && drizzle-kit generate",
    "db:migrate:notification": "cd apps/notification-service && drizzle-kit migrate",
    "proto:gen": "mkdir -p libs/contracts/src/generated && find libs/contracts/proto -name '*.proto' -exec grpc_tools_node_protoc -I libs/contracts/proto --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=libs/contracts/src/generated --ts_proto_opt=nestJs=true,importSuffix=.js,esModuleInterop=true,outputServices=generic-definitions,useExactTypes=false {} +",
    "lint": "oxlint --type-aware apps libs test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@golevelup/ts-vitest": "^4.0.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/drizzle": "^0.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/outbox": "0.1.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/resilience": "0.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/websockets": "^12.1.2",
    "@rspack/core": "^2.2.8",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.45.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "grpc-tools": "^1.13.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "ts-proto": "^2.13.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "patchedDependencies": {
    "kafkajs@2.2.4": "patches/kafkajs@2.2.4.patch"
  }
}
